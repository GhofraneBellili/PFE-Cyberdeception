  {
    "chunk_id": "d3fend:D3-DO:1",
    "source_id": "d3fend.json",
    "source_type": "d3fend",
    "document_id": "D3-DO",
    "locator": "d3f:definition",
    "text": "A Decoy Object is created and deployed for the purposes of deceiving attackers.",
    "text_hash": "77c6dbddc441ed7e67495b84281eb8d62c839f50256fa87b1bea2f1c1cf8b0a3",
    "metadata": {
      "concept_name": "Decoy Object",
